# MyFlipbook server environment (copy to your process manager / systemd unit).
# Never commit real keys.

# Copy this file to .env (same folder as server.py): the server reads it at start.

# Midtrans Snap (rupiah payments, default gateway). Dashboard Midtrans -> Settings -> Access Keys.
# Sandbox keys start with SB-. Payment notification URL (Settings -> Configuration):
#   https://<your domain>/api/billing/midtrans/notify
MIDTRANS_SERVER_KEY=
# 1 = live payments (app.midtrans.com); empty = sandbox.
MIDTRANS_PRODUCTION=

# Tripay (alternative). Used when Midtrans has no key, or MYFLIPBOOK_IDR_PROVIDER=tripay.
MYFLIPBOOK_IDR_PROVIDER=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
# 1 = live payments (tripay.co.id/api); empty = sandbox (tripay.co.id/api-sandbox).
TRIPAY_PRODUCTION=

# Lemon Squeezy (US dollar subscriptions for buyers abroad). Dashboard -> Settings -> API / Webhooks.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_SIGNING_SECRET=
# Subscription variant IDs (create products with these USD prices: Pro $9.99/mo, $99/yr; Business $19.99/mo, $199/yr).
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_BUSINESS_MONTHLY=
LEMONSQUEEZY_VARIANT_BUSINESS_YEARLY=

# Public URL used for the payment "finish" redirect.
MYFLIPBOOK_BASE_URL=https://myflipbook.id
# SQLite database path (default: .data/myflipbook.sqlite3 next to server.py).
MYFLIPBOOK_DB=
# 1 = allow simulated payments even in hosting mode (testing only).
MYFLIPBOOK_MOCK_PAYMENTS=
# Seller block on PDF invoices, lines separated by |
MYFLIPBOOK_INVOICE_SELLER=MyFlipbook by Sarvamaya|Your address, City|billing@example.com|NPWP (optional)
