# MyFlipbook server environment (copy to your process manager / systemd unit).
# Never commit real keys.

# Tripay (used when all three are set). Dashboard Tripay -> Merchant -> API.
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
# 1 = live payments (tripay.co.id/api); empty = sandbox (tripay.co.id/api-sandbox).
TRIPAY_PRODUCTION=

# Midtrans Snap server key (alternative to Tripay). Sandbox keys start with SB-.
MIDTRANS_SERVER_KEY=
# 1 = live payments (app.midtrans.com); empty = sandbox.
MIDTRANS_PRODUCTION=
# Public URL used for the payment "finish" redirect.
MYFLIPBOOK_BASE_URL=https://myflipbook.id
# SQLite database path (default: .data/myflipbook.sqlite3 next to server.py).
MYFLIPBOOK_DB=
# 1 = allow simulated payments even in hosting mode (testing only).
MYFLIPBOOK_MOCK_PAYMENTS=
