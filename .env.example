# MyFlipbook server environment (copy to your process manager / systemd unit).
# Never commit real keys.

# Copy this file to .env (same folder as server.py): the server reads it at start.

# Duitku POP (rupiah payments, default gateway when set). Dashboard Duitku -> Project -> API.
# Sandbox dulu, DUITKU_PRODUCTION=1 untuk live. Callback URL di dashboard:
#   https://<your domain>/api/payment/duitku/callback
# Pilih paksa gateway rupiah: MYFLIPBOOK_IDR_PROVIDER=duitku|midtrans|tripay (kosong = otomatis).
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# 1 = live payments (api-prod.duitku.com); empty = sandbox (api-sandbox.duitku.com).
DUITKU_PRODUCTION=

# Midtrans Snap (rupiah payments, default gateway). Dashboard Midtrans -> Settings -> Access Keys.
# Sandbox keys start with SB-. Payment notification URL (Settings -> Configuration):
#   https://<your domain>/api/billing/midtrans/notify
MIDTRANS_SERVER_KEY=
# 1 = live payments (app.midtrans.com); empty = sandbox.
MIDTRANS_PRODUCTION=

# Tripay (alternative). Used when Duitku/Midtrans have no key, or MYFLIPBOOK_IDR_PROVIDER=tripay.
MYFLIPBOOK_IDR_PROVIDER=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
# 1 = live payments (tripay.co.id/api); empty = sandbox (tripay.co.id/api-sandbox).
TRIPAY_PRODUCTION=

# Lemon Squeezy (US dollar subscriptions for buyers abroad). Dashboard -> Settings -> API / Webhooks.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_SIGNING_SECRET=
# Subscription variant IDs (create products with these USD prices: Pro $9.99/mo, $99/yr; Business $19.99/mo, $199/yr).
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_BUSINESS_MONTHLY=
LEMONSQUEEZY_VARIANT_BUSINESS_YEARLY=

# Public URL used for the payment "finish" redirect.
MYFLIPBOOK_BASE_URL=https://myflipbook.id
# SQLite database path (default: .data/myflipbook.sqlite3 next to server.py).
MYFLIPBOOK_DB=
# 1 = allow simulated payments even in hosting mode (testing only).
MYFLIPBOOK_MOCK_PAYMENTS=
# Seller block on PDF invoices, lines separated by |
MYFLIPBOOK_INVOICE_SELLER=MyFlipbook by Sarvamaya|Your address, City|billing@example.com|NPWP (optional)

# ===================== Pencarian versi 2 (jurnal, ebook, majalah) =====================
# Semua gratis. Isi nilainya setelah tanda = (tanpa spasi, tanpa tanda kutip).
# Kosong = sumber itu dilewati; pencarian tetap jalan dengan sumber lain.

# 1) CORE — jutaan teks lengkap jurnal & skripsi dari repositori kampus (termasuk Indonesia).
#    Daftar: https://core.ac.uk/services/api  -> "Register now" -> isi nama, email, tujuan:
#    "Search open-access research for an Indonesian reading platform (myflipbookpro.com)".
#    Kunci dikirim lewat email.
CORE_API_KEY=

# 2) Semantic Scholar — jumlah kutipan, ringkasan singkat (TLDR), dan link PDF.
#    Minta: https://www.semanticscholar.org/product/api#api-key-form  (isi form, kunci dikirim lewat email).
SEMANTIC_SCHOLAR_API_KEY=

# 3) Google Books — buku domain publik gratis + pratinjau.
#    https://console.cloud.google.com/ -> pilih project MyFlipbook -> "APIs & Services" -> "Library"
#    -> cari "Books API" -> Enable -> "Credentials" -> "Create credentials" -> "API key".
#    Batasi kuncinya: "API restrictions" -> pilih "Books API" saja; "Application restrictions" -> "IP addresses"
#    -> isi IP server 38.103.170.218 (dan IP kantor bila dites dari PC). Jangan pakai GOOGLE_API_KEY yang lama
#    (itu kunci browser untuk Google Drive).
GOOGLE_BOOKS_API_KEY=

# 4) OpenAlex (sumber jurnal utama) — email kontak supaya masuk "polite pool" (lebih cepat, jarang kena batas).
#    Cukup isi email kantor, tidak perlu daftar.
OPENALEX_MAILTO=

# =====================================================================================
# AI langsung lewat Google Gemini API (paid tier): model "gemini-…" (tanpa garis miring),
# mis. gemini-3.8-flash. Model "gemini/…" (format Sumopod) lan liyane tetep lewat Sumopod
# (SUMOPOD_API_KEY). Kunci teko Google AI Studio / Cloud, batasi nang "Generative Language API"
# lan IP server.
GEMINI_API_KEY=
# SUMMARY_MODEL=gemini-3.8-flash      # ringkasan (AI Ringkasan + stabilo Flipbook)
# TRANSLATE_MODEL=gemini-3.8-flash    # terjemahan AI
# ASK_MODEL=                          # Tanya dokumen (kosong = melu SUMMARY_MODEL)
